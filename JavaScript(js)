function navegar(pagina) {
    const app = document.getElementById('app');
    if (templates[pagina]) {
        app.innerHTML = templates[pagina];
        window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
        app.innerHTML = '<h2>Página não encontrada!</h2>';
    }
}

document.addEventListener('DOMContentLoaded', () => {
    navegar('home');
});


function validarFormulario(event) {
    event.preventDefault(); 

    
    const campos = {
        tipo: document.getElementById('tipo'),
        nome: document.getElementById('nome'),
        cpf: document.getElementById('cpf'),
        email: document.getElementById('email'),
        telefone: document.getElementById('telefone'),
        cep: document.getElementById('cep'),
        endereco: document.getElementById('endereco'),
        cidade: document.getElementById('cidade'),
        estado: document.getElementById('estado')
    };

    
    for (let key in campos) {
        campos[key].classList.remove('input-erro');
    }

    let temErro = false;
    if (campos.tipo.value === "") { campos.tipo.classList.add('input-erro'); temErro = true; }
    if (campos.nome.value.trim().length < 3) { campos.nome.classList.add('input-erro'); temErro = true; }
    if (campos.cpf.value.length < 11) { campos.cpf.classList.add('input-erro'); temErro = true; }
    if (campos.email.value.indexOf('@') === -1 || campos.email.value.indexOf('.') === -1) { campos.email.classList.add('input-erro'); temErro = true; }
    if (campos.telefone.value.length < 8) { campos.telefone.classList.add('input-erro'); temErro = true; }
    
    if (campos.cep.value.length < 8) { campos.cep.classList.add('input-erro'); temErro = true; }
    if (campos.endereco.value.trim() === "") { campos.endereco.classList.add('input-erro'); temErro = true; }
    if (campos.cidade.value.trim() === "") { campos.cidade.classList.add('input-erro'); temErro = true; }
    if (campos.estado.value === "") { campos.estado.classList.add('input-erro'); temErro = true; }

  
    if (temErro) {
        alert("⚠️ Por favor, preencha corretamente os campos destacados em vermelho.");
    } else {
        alert("✅ Sucesso! Cadastro realizado com sucesso.\nEntraremos em contato em breve, " + campos.nome.value + "!");
        document.getElementById('form-cadastro').reset();
        setTimeout(() => navegar('home'), 1000);
    }
}
